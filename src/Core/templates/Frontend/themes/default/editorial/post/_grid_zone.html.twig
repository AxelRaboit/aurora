{# What one zone renders as, whatever holds it.

   Pulled out of `_grid.html.twig` when stacks arrived: a stacked child renders
   exactly like a zone on a row, and the alternative was the same forty lines
   written twice, drifting apart on the first change. `twoColumn` is in this
   file's history as the cost of that drift - a renderer reading a shape its own
   tool no longer wrote.

   Takes `zone` and `locale`. Nothing about where the zone sits belongs here:
   the caller owns the box and its geometry. #}

{% import 'Frontend/themes/default/editorial/post/_grid_surface.html.twig' as surface %}

{# The zone itself, captured rather than printed: what it sits on is decided
   below, and a surface has to wrap it. A capture is safe markup in Twig, so
   nothing is escaped twice on the way out. #}
{% set body %}

    {% if zone.type == 'text' and zone.html %}
        {# Already sanitised by BlocksRenderer, which every block type
           goes through - the same path the plain block column uses. #}
        {# Three settings of one column. `lead` enlarges the first paragraph
           and lifts its colour, which is what a standfirst is; `small` is fine
           print. Written out literally - Tailwind only emits classes it can
           read in the source. #}
        {% set textSizes = {
            normal: '',
            lead: 'prose-lg [&>p:first-of-type]:text-xl [&>p:first-of-type]:text-primary',
            small: 'prose-sm text-muted',
        } %}
        <div class="prose max-w-none {{ textSizes[zone.textSize] }}">{{ zone.html|raw }}</div>

    {% elseif zone.type == 'media' and zone.media %}
        {# `fill` is the one shape that is not a ratio: it takes the height of
           the box it is in and crops into it, which is how a picture stops
           leaving a gap under itself when its neighbour is taller. A height
           cannot be an `aspect-ratio`, so it is classes here rather than a
           declaration from the view builder.

           Only from `lg` up. Below it every zone is alone on its row, so the
           box has no height of its own to fill - `flex-1` against an auto
           height would collapse the picture to nothing. There it reads as
           `natural`, which is what a picture alone on a phone should be
           anyway. #}
        {% set fills = zone.ratio == 'fill' %}

        {# `scaleStyle` narrows the figure and says which side it sits on. The
           picture inside keeps `width: 100%`, so its height follows its own
           proportions and the author gets a smaller picture rather than a
           squashed one.

           On the figure and not on the image: the caption should sit under the
           picture it belongs to, at its width and on its side, not run the full
           column beneath a small photograph. #}
        {# Full bleed is not handled here any more: it is the wrapper at the
           foot of this file, which does the same thing for every type rather
           than only for a picture. #}
        <figure
            class="m-0 not-prose{{ fills ? ' lg:flex lg:h-full lg:flex-col' : '' }}"
            style="{{ zone.scaleStyle|default('')|raw }}"
        >
            {# `ratioStyle` is empty unless the zone asks to be cropped.
               With a width of 100% and `height: auto`, an `aspect-ratio`
               settles the height on its own - no wrapper, no second
               element.
               `object-cover` and the focal position, both already here,
               are what make the crop land where the picture matters. #}
            {# A button around the picture, not a link: it opens an overlay on
               this page rather than going anywhere. The picture inside is the
               content and not a thumbnail of it, so without the overlay's
               script this is a button that does nothing to a picture that is
               already all there - which is the right way round. #}
            {% set enlargeable = zone.lightboxIndex is defined and zone.lightboxIndex is not null %}
            {% set picture %}
                <img
                    src="{{ zone.media.url }}"
                    alt="{{ zone.media.alt }}"
                    loading="lazy"
                    class="w-full h-auto rounded-lg object-cover{{ fills ? ' lg:min-h-0 lg:flex-1' : '' }}"
                    style="object-position: {{ zone.media.focalPosition }};{{ zone.ratioStyle }}"
                >
            {% endset %}
            {% if enlargeable %}
                <button
                    type="button"
                    data-grid-image-open="{{ zone.lightboxIndex }}"
                    class="block w-full cursor-zoom-in appearance-none border-0 bg-transparent p-0 text-left{{ fills ? ' lg:min-h-0 lg:flex-1' : '' }}"
                    aria-label="{{ 'frontend.gallery.enlarge'|trans }}"
                >{{ picture }}</button>
            {% else %}
                {{ picture }}
            {% endif %}
            {% if zone.caption %}
                {# `shrink-0` so the caption keeps its line when the picture
                   above it is taking every pixel it can. #}
                <figcaption class="mt-2 text-sm text-secondary{{ fills ? ' lg:shrink-0' : '' }}">{{ zone.caption }}</figcaption>
            {% endif %}
            {% if zone.media.credit %}
                {# Not decoration: a stock photo may only be shown with its
                   photographer named, so this line travels with the picture
                   wherever the zone is rendered. #}
                {{ include('Frontend/themes/default/editorial/post/_media_credit.html.twig', {credit: zone.media.credit}, false) }}
            {% endif %}
        </figure>

    {% elseif zone.type == 'post' and zone.post %}
        {{ include('Frontend/themes/default/editorial/_post_card.html.twig', {post: zone.post, locale: locale, variant: zone.cardVariant}) }}

    {% elseif zone.type == 'button' and zone.button %}
        {# Written out literally rather than assembled: Tailwind only emits
           classes it can read in the source, and `px-{{ size }}` is one it
           never sees. #}
        {% set buttonSizes = {
            sm: 'px-4 py-2 text-sm',
            md: 'px-6 py-3 text-base',
            lg: 'px-8 py-4 text-lg',
        } %}
        {% set buttonVariants = {
            solid: 'bg-accent text-white border border-transparent hover:opacity-90',
            outline: 'border border-accent text-accent hover:bg-accent hover:text-white',
            ghost: 'border border-transparent text-accent hover:bg-accent-500/10',
        } %}
        <div class="not-prose flex {{ zone.align == 'center' ? 'justify-center' : (zone.align == 'end' ? 'justify-end' : 'justify-start') }}">
            <a
                href="{{ zone.button.url }}"
                class="inline-flex items-center gap-2 rounded-lg font-medium no-underline transition {{ buttonSizes[zone.size] }} {{ buttonVariants[zone.variant] }}"
            >{{ zone.button.label }}</a>
        </div>

    {% elseif zone.type == 'separator' %}
        {# A rule, or the same room with nothing drawn in it. Both are the
           point: a page needs to breathe as often as it needs dividing. #}
        {% set separatorSizes = {sm: 'py-2', md: 'py-6', lg: 'py-12'} %}
        <div class="not-prose {{ separatorSizes[zone.size] }}" aria-hidden="true">
            {% if zone.separatorStyle == 'line' %}<hr class="m-0 border-t border-line">{% endif %}
        </div>

    {% elseif zone.type == 'items' and zone.items.entries is not empty %}
        {{ include('Frontend/themes/default/editorial/post/_grid_items.html.twig', {items: zone.items}) }}

    {% elseif zone.type == 'postList' and zone.postList.cards is not empty %}
        {# Written out literally: Tailwind only emits classes it can read in
           the source. A compact list stays one column - its whole point is a
           dense column, and two of them side by side is the full card again. #}
        {% set listColumns = {
            2: 'sm:grid-cols-2',
            3: 'sm:grid-cols-2 lg:grid-cols-3',
            4: 'sm:grid-cols-2 lg:grid-cols-4',
        } %}
        <div class="not-prose grid grid-cols-1 gap-4 {{ zone.postList.variant == 'compact' ? '' : listColumns[zone.postList.columns] }}">
            {% for card in zone.postList.cards %}
                {{ include('Frontend/themes/default/editorial/_post_card.html.twig', {
                    post: card,
                    locale: locale,
                    variant: zone.postList.variant,
                }) }}
            {% endfor %}
        </div>

    {% elseif zone.type == 'form' and zone.form %}
        {# The same component the form's own page mounts, posting to the same
           endpoint - so the validation, the rate limit and the confirmation
           are one implementation wherever the form is drawn. #}
        <div class="not-prose space-y-4">
            {% if zone.form.title %}
                <h2 class="m-0 text-xl font-semibold text-primary">{{ zone.form.title }}</h2>
            {% endif %}
            {% if zone.form.description %}
                <p class="m-0 text-secondary">{{ zone.form.description }}</p>
            {% endif %}
            <div {{ vue_component('editorial/frontend/FormRender', {
                form: zone.form.data,
                submitPath: zone.form.submitPath,
            }) }}></div>
        </div>

    {% elseif zone.type == 'code' and zone.code %}
        {# Readable before any script runs, coloured once one does: the class
           is what `codeHighlight.js` looks for, and a reader whose JavaScript
           never arrives still gets the snippet, in a monospace box, intact.

           `{{ }}` escapes - the snippet is shown, never interpreted. #}
        <div class="not-prose relative overflow-hidden rounded-xl border border-line bg-surface" data-code-zone>
            <div class="absolute right-3 top-2 flex items-center gap-3">
                {% if zone.language %}
                    <span class="text-2xs uppercase tracking-wider text-muted">{{ zone.language }}</span>
                {% endif %}
                {# Hidden until `codeCopy.js` finds a clipboard to write to:
                   a button that cannot do its job should not be offered. #}
                <button
                    type="button"
                    hidden
                    data-code-copy="{{ 'frontend.editorial.grid.copy'|trans }}"
                    data-code-copied="{{ 'frontend.editorial.grid.copied'|trans }}"
                    class="rounded-md border border-line bg-surface-2 px-2 py-0.5 text-2xs text-secondary transition-colors hover:text-primary"
                >{{ 'frontend.editorial.grid.copy'|trans }}</button>
            </div>

            {# The numbers are a column beside the snippet rather than anything
               inserted into it: the highlighter owns what is inside <code>,
               and a gutter of its own cannot break a string that runs over two
               lines. It lines up because a <pre> scrolls rather than wraps, so
               one line of code is one line on screen - and both columns are
               set in the same size and leading, which is what keeps them in
               step.

               `select-none` and `aria-hidden` so copying the snippet, by hand
               or with the button, copies code and not coordinates. #}
            {% set numbered = zone.lineNumbers|default(false) %}
            <div class="flex{{ numbered ? ' overflow-x-auto' : '' }}">
                {% if numbered %}
                    <div
                        class="shrink-0 select-none whitespace-pre border-r border-line py-4 pl-4 pr-3 text-right font-mono text-sm leading-relaxed text-muted"
                        aria-hidden="true"
                    >{% for line in 1..(zone.code|split('\n')|length) %}{{ line }}{% if not loop.last %}{{ '\n' }}{% endif %}{% endfor %}</div>
                {% endif %}
                <pre class="m-0 flex-1 overflow-x-auto p-4 text-sm leading-relaxed"><code{% if zone.language %} class="language-{{ zone.language }}"{% endif %}>{{ zone.code }}</code></pre>
            </div>
        </div>

    {% elseif zone.type == 'video' %}
        {% if zone.video %}
            {# The src is built from an extracted id against a whitelist
               of three providers - see VideoEmbedResolver. An iframe
               runs what its host serves, so an arbitrary address is
               never put here. #}
            <div class="relative aspect-video overflow-hidden rounded-lg not-prose">
                <iframe
                    src="{{ zone.video.embedUrl }}"
                    class="absolute inset-0 h-full w-full"
                    loading="lazy"
                    referrerpolicy="strict-origin-when-cross-origin"
                    allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                    allowfullscreen
                    title="{{ zone.caption ?: 'Vidéo' }}"
                ></iframe>
            </div>
            {% if zone.caption %}
                <p class="mt-2 text-sm text-secondary">{{ zone.caption }}</p>
            {% endif %}
        {% elseif zone.url %}
            {# An address no provider claims still reaches the reader,
               as a link. Showing nothing would look like a bug to the
               author, who pasted something and saw it accepted. #}
            <a href="{{ zone.url }}" rel="noopener" class="text-sm underline not-prose">
                {{ zone.caption ?: zone.url }}
            </a>
        {% endif %}
    {% endif %}
{% endset %}

{{ surface.wrap(zone, body) }}
