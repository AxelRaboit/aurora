{# A short list of small things, in one of five costumes.

   `items` comes from GridViewBuilder and carries `display`, `columns` and
   `entries`; the caller has already checked there is at least one entry, so
   nothing here draws an empty frame.

   Four fields serve the five displays, because they are the same four
   questions asked differently - a step's title is a figure's value is a
   question is a quote's author. What changes between costumes is which of
   them is loud, which is quiet, and in what order they are read.

   Column counts are written out literally: Tailwind only emits classes it can
   read in the source, and `md:grid-cols-{{ n }}` is one it never sees. #}

{% set columns = {
    2: 'sm:grid-cols-2',
    3: 'sm:grid-cols-2 lg:grid-cols-3',
    4: 'sm:grid-cols-2 lg:grid-cols-4',
} %}

<div class="not-prose">
    {% if items.display == 'steps' %}
        {# Numbered, and the number is the point: a process is read in order,
           so it is drawn as an order. The rule down the left is what makes
           three separate boxes read as one sequence. #}
        <ol class="m-0 list-none space-y-6 border-l border-line p-0 pl-6">
            {% for entry in items.entries %}
                <li class="relative">
                    <span
                        class="absolute -left-[2.05rem] flex h-8 w-8 items-center justify-center rounded-full border border-line bg-surface text-sm font-semibold text-accent"
                        aria-hidden="true"
                    >{{ entry.position }}</span>
                    {% if entry.title %}<h3 class="m-0 text-lg font-semibold text-primary">{{ entry.title }}</h3>{% endif %}
                    {% if entry.description %}<p class="mt-1 mb-0 text-secondary">{{ entry.description }}</p>{% endif %}
                </li>
            {% endfor %}
        </ol>

    {% elseif items.display == 'stats' %}
        {# The figure first and large, its meaning under it small: a number
           without its unit says nothing, and a number read after its label
           has already lost the glance it was there to catch. #}
        <dl class="m-0 grid grid-cols-1 gap-6 {{ columns[items.columns] }}">
            {% for entry in items.entries %}
                <div class="rounded-xl border border-line bg-surface p-6">
                    <dt class="m-0 text-3xl font-bold text-accent sm:text-4xl">{{ entry.title }}</dt>
                    {% if entry.description %}<dd class="m-0 mt-1 text-sm text-secondary">{{ entry.description }}</dd>{% endif %}
                </div>
            {% endfor %}
        </dl>

    {% elseif items.display == 'faq' %}
        {# `<details>` rather than a script: it opens without JavaScript, it is
           announced correctly, and a browser's find-in-page reaches inside a
           closed one. The marker is hidden and replaced by a sign that turns,
           because the default triangle cannot be styled across browsers. #}
        <div class="divide-y divide-line border-y border-line">
            {% for entry in items.entries %}
                <details class="group py-4">
                    <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-medium text-primary [&::-webkit-details-marker]:hidden">
                        {{ entry.title }}
                        <span class="shrink-0 text-accent transition-transform group-open:rotate-45" aria-hidden="true">+</span>
                    </summary>
                    {% if entry.description %}<p class="mt-3 mb-0 text-secondary">{{ entry.description }}</p>{% endif %}
                </details>
            {% endfor %}
        </div>

    {% elseif items.display == 'quotes' %}
        {# The quote before the name, which is the order it is read in, and a
           `<blockquote>` because that is what it is. #}
        <div class="grid grid-cols-1 gap-6 {{ columns[items.columns] }}">
            {% for entry in items.entries %}
                <figure class="m-0 flex h-full flex-col rounded-xl border border-line bg-surface p-6">
                    {% if entry.description %}
                        <blockquote class="m-0 flex-1 border-0 p-0 text-secondary not-italic">{{ entry.description }}</blockquote>
                    {% endif %}
                    <figcaption class="mt-4 flex items-center gap-3">
                        {% if entry.media %}
                            <img
                                src="{{ entry.media.url }}"
                                alt=""
                                loading="lazy"
                                class="h-10 w-10 shrink-0 rounded-full object-cover"
                                style="object-position: {{ entry.media.focalPosition }};"
                            >
                        {% endif %}
                        <span class="min-w-0">
                            {% if entry.title %}<span class="block truncate font-medium text-primary">{{ entry.title }}</span>{% endif %}
                            {% if entry.caption %}<span class="block truncate text-sm text-muted">{{ entry.caption }}</span>{% endif %}
                        </span>
                    </figcaption>
                </figure>
            {% endfor %}
        </div>

    {% else %}
        {# Logos. Muted until hovered, so a row of client marks reads as one
           band rather than as a dozen competing colours. The name is the alt
           text, which is what a screen reader has to go on. #}
        <ul class="m-0 flex list-none flex-wrap items-center justify-center gap-x-10 gap-y-6 p-0">
            {% for entry in items.entries %}
                <li class="m-0">
                    {% set logo %}
                        {% if entry.media %}
                            <img
                                src="{{ entry.media.url }}"
                                alt="{{ entry.title }}"
                                loading="lazy"
                                class="h-8 w-auto opacity-60 grayscale transition duration-200 hover:opacity-100 hover:grayscale-0 sm:h-10"
                            >
                        {% else %}
                            <span class="text-sm font-medium text-muted transition-colors hover:text-primary">{{ entry.title }}</span>
                        {% endif %}
                    {% endset %}
                    {% if entry.url %}
                        <a href="{{ entry.url }}" rel="noopener" class="block no-underline">{{ logo }}</a>
                    {% else %}
                        {{ logo }}
                    {% endif %}
                </li>
            {% endfor %}
        </ul>
    {% endif %}
</div>
