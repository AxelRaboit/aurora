{% extends '@Studio/public/layout.html.twig' %}

{% block title %}{{ 'studio.public.unavailable.title'|trans }}{% endblock %}

{# One page for every failure: unknown address, wrong secret, revoked, expired.
   Telling them apart would tell a stranger which of their guesses landed, and
   would confirm that an address they tried was once real. #}
{% block body %}
    <div class="flex flex-1 flex-col items-center justify-center gap-3 py-16 text-center">
        <h1 class="text-lg font-semibold text-primary">
            {{ 'studio.public.unavailable.title'|trans }}
        </h1>
        <p class="max-w-md text-sm text-secondary">
            {{ 'studio.public.unavailable.message'|trans }}
        </p>
    </div>
{% endblock %}
