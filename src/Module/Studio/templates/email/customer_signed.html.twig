{# The provider's cue that a contract is waiting to be concluded.

   Carries the evidence a reader would want before countersigning: who signed,
   from where, when, and against which document. Not the drawn signature, which
   belongs on the page behind a login. #}
<p>{{ 'studio.email.customer_signed.body'|trans({'{reference}': contract.reference, '{name}': signature.declaredFullName}) }}</p>

<ul>
    <li>{{ 'studio.email.customer_signed.declared'|trans({'{place}': signature.declaredPlace, '{date}': signature.declaredDate|date('d/m/Y')}) }}</li>
    <li>{{ 'studio.email.customer_signed.observed'|trans({'{at}': signature.signedAt|date('d/m/Y H:i'), '{ip}': signature.ipAddress ?? '-'}) }}</li>
    <li>{{ 'studio.email.customer_signed.hash'|trans({'{hash}': signature.signedContentHash|slice(0, 16)}) }}</li>
</ul>

<p>{{ 'studio.email.customer_signed.action'|trans }}</p>
