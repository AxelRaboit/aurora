{% extends '@Core/backend/layout.html.twig' %}

{% block title %}{{ contract.reference ?? 'backend.studio.contracts.draft_title'|trans }} - {{ parent() }}{% endblock %}

{% block page_header_slot %}
    {{ include('@Shared/components/page_header.html.twig', {
        crumbs: [
            {label: 'backend.nav.sections.studio'|trans},
            {label: 'backend.nav.studio_contracts'|trans, href: indexPath},
            {label: contract.reference ?? contract.customerName},
        ],
    }) }}
{% endblock %}

{% block body %}
<div {{ vue_component('studio/backend/contracts/ContractDocumentApp', {
    contract: contract,
    indexPath: indexPath,
    freezePath: freezePath,
    countersignPath: countersignPath,
    pdfPath: pdfPath,
    terminatePath: terminatePath,
    amendPath: amendPath,
    terminationOrigins: terminationOrigins,
}) }} class="flex-1 min-w-0"></div>
{% endblock %}
