{% extends '@Core/backend/layout.html.twig' %}

{% block title %}{{ 'backend.nav.accounting_contract_templates'|trans }} - {{ parent() }}{% endblock %}

{% block page_header_slot %}
    {{ include('@Shared/components/page_header.html.twig', {
        crumbs: [
            {label: 'backend.nav.sections.accounting'|trans},
            {label: 'backend.nav.accounting_contract_templates'|trans},
        ],
    }) }}
{% endblock %}

{% block body %}
<div {{ vue_component('accounting/backend/contract-templates/ContractTemplatesApp', {
    templates: templates,
    kinds: kinds,
    createPath: createPath,
    updatePath: updatePath,
    archivePath: archivePath,
    restorePath: restorePath,
    deletePath: deletePath,
    openDraftPath: openDraftPath,
    editorPath: editorPath,
}) }} class="flex-1 min-w-0"></div>
{% endblock %}
