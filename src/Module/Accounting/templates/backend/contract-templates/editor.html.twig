{% extends '@Core/backend/layout.html.twig' %}

{% block title %}{{ template.name }} - {{ parent() }}{% endblock %}

{% block page_header_slot %}
    {{ include('@Shared/components/page_header.html.twig', {
        crumbs: [
            {label: 'backend.nav.sections.accounting'|trans},
            {label: 'backend.nav.accounting_contract_templates'|trans, href: indexPath},
            {label: template.name},
        ],
    }) }}
{% endblock %}

{% block body %}
<div {{ vue_component('accounting/backend/contract-templates/ContractTemplateEditorApp', {
    template: template,
    version: version,
    versions: versions,
    locales: locales,
    variableGroups: variableGroups,
    savePath: savePath,
    publishPath: publishPath,
    discardPath: discardPath,
    indexPath: indexPath,
    editorPath: editorPath,
}) }} class="flex-1 min-w-0"></div>
{% endblock %}
