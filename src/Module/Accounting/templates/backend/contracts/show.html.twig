{% extends '@Core/backend/layout.html.twig' %}

{% block title %}{{ contract.reference ?? 'backend.accounting.contracts.draft_title'|trans }} - {{ parent() }}{% endblock %}

{% block page_header_slot %}
    {{ include('@Shared/components/page_header.html.twig', {
        crumbs: [
            {label: 'backend.nav.sections.accounting'|trans},
            {label: 'backend.nav.accounting_contracts'|trans, href: indexPath},
            {label: contract.reference ?? contract.customerName},
        ],
    }) }}
{% endblock %}

{% block body %}
<div {{ vue_component('accounting/backend/contracts/ContractDocumentApp', {
    contract: contract,
    indexPath: indexPath,
    freezePath: freezePath,
}) }} class="flex-1 min-w-0"></div>
{% endblock %}
