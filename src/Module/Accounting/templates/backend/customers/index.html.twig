{% extends '@Core/backend/layout.html.twig' %}

{% block title %}{{ 'backend.nav.accounting_customers'|trans }} - {{ parent() }}{% endblock %}

{% block page_header_slot %}
    {{ include('@Shared/components/page_header.html.twig', {
        crumbs: [
            {label: 'backend.nav.sections.accounting'|trans},
            {label: 'backend.nav.accounting_customers'|trans},
        ],
    }) }}
{% endblock %}

{% block body %}
<div {{ vue_component('accounting/backend/customers/CustomersApp', {
    customers: customers,
    users: users,
    currencies: currencies,
    createPath: createPath,
    updatePath: updatePath,
    deletePath: deletePath,
}) }} class="flex-1 min-w-0"></div>
{% endblock %}
