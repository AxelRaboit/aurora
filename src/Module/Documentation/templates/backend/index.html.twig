{% extends '@Core/backend/layout.html.twig' %}

{% block title %}{{ page.title }} - {{ parent() }}{% endblock %}

{# La section et l'entrée de menu portent le même mot, et le fil d'Ariane
   le répétait. La section, la rubrique, la page : trois crans qui disent
   chacun quelque chose. Une section ne porte pas de lien, comme partout
   ailleurs : elle nomme un endroit, elle n'est pas une page. Un commentaire
   Twig ne peut pas vivre à l'intérieur d'une expression, d'où sa place
   ici. #}
{% block page_header_slot %}
    {{ include('@Shared/components/page_header.html.twig', {
        crumbs: [
            {label: 'backend.nav.sections.documentation'|trans},
            {label: page.rubric},
            {label: page.title},
        ],
    }) }}
{% endblock %}

{% block body %}
<div {{ vue_component('documentation/backend/documentation/DocumentationApp', {
    page: page,
    neighbours: neighbours,
    pagePathTemplate: pagePathTemplate,
    imagePathTemplate: imagePathTemplate,
}) }} class="flex-1 min-w-0"></div>
{% endblock %}
